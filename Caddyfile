# Proxy reverso de produção. Fica atrás do túnel da Cloudflare: quem termina o
# HTTPS é a Cloudflare, e o `cloudflared` da ubuntu-server repassa a visita em
# HTTP para cá (127.0.0.1:8481 no host, :80 dentro do container). Por isso não
# há certificado nem Let's Encrypt aqui, e o site escuta em qualquer nome: só o
# túnel chega nesta porta, e quem decide que domínio aponta para ela é a rota
# do túnel no painel da Cloudflare.
#
# Continua servindo tudo numa origem só:
#
#   /api/*  -> API Go (o prefixo /api é removido antes de repassar)
#   /*      -> frontend SvelteKit (servidor Node do adapter-node)
#
# Origem única = o cookie de sessão SameSite=Lax funciona sem mudança de código
# e não há CORS entre frontend e API.

:80 {
	encode gzip zstd

	# Cabeçalhos de segurança seguros (não quebram o app). HSTS assume
	# compromisso com HTTPS — correto: o navegador só fala com a Cloudflare, e
	# ela só serve HTTPS.
	#
	# A Content-Security-Policy NÃO fica aqui: ela é emitida pelo SvelteKit
	# (kit.csp no vite.config.ts), que sabe o hash dos scripts que gera a cada
	# build. Duas CSPs na mesma resposta valem pela interseção — a daqui
	# quebraria o app na primeira divergência de build.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# O app não usa nenhuma dessas APIs; negar todas evita que um script
		# injetado (ou um iframe de terceiro) as alcance.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		# Isola a janela de popups de outra origem (o consentimento do Google
		# abre e volta na mesma aba, então nada do fluxo depende disso).
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# API sob /api/* — handle_path remove o prefixo (/api/auth/me -> /auth/me).
	handle_path /api/* {
		# a documentação Swagger não fica exposta na internet em produção
		@swagger path /swagger /swagger/*
		respond @swagger 404

		reverse_proxy api:8080 {
			# Passa o IP real do visitante para a API logar e limitar por IP —
			# sem isto ela veria sempre o IP do container do Caddy. Atrás do
			# túnel, o par da conexão é o cloudflared, então o IP vem do
			# CF-Connecting-IP, que a Cloudflare reescreve em toda requisição.
			# Confiar nele é seguro porque a porta só escuta em 127.0.0.1, onde
			# só o túnel chega. header_up substitui qualquer X-Real-IP que o
			# cliente tente enviar.
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		}
	}

	# Todo o resto é o frontend.
	handle {
		reverse_proxy web:3000
	}
}
