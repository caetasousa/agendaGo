# Proxy reverso de produção. O Caddy pega um certificado Let's Encrypt
# automaticamente para {$DOMINIO} (precisa das portas 80/443 abertas e do
# domínio apontando para o IP do host) e serve tudo numa origem só:
#
#   /api/*  -> API Go (o prefixo /api é removido antes de repassar)
#   /*      -> frontend SvelteKit (servidor Node do adapter-node)
#
# Origem única = o cookie de sessão SameSite=Lax funciona sem mudança de código
# e não há CORS entre frontend e API.

{$DOMINIO} {
	encode gzip zstd

	# Cabeçalhos de segurança seguros (não quebram o app). HSTS assume
	# compromisso com HTTPS — correto atrás do Caddy.
	#
	# A Content-Security-Policy NÃO fica aqui: ela é emitida pelo SvelteKit
	# (kit.csp no vite.config.ts), que sabe o hash dos scripts que gera a cada
	# build. Duas CSPs na mesma resposta valem pela interseção — a daqui
	# quebraria o app na primeira divergência de build.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# O app não usa nenhuma dessas APIs; negar todas evita que um script
		# injetado (ou um iframe de terceiro) as alcance.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		# Isola a janela de popups de outra origem (o consentimento do Google
		# abre e volta na mesma aba, então nada do fluxo depende disso).
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# API sob /api/* — handle_path remove o prefixo (/api/auth/me -> /auth/me).
	handle_path /api/* {
		# a documentação Swagger não fica exposta na internet em produção
		@swagger path /swagger /swagger/*
		respond @swagger 404

		reverse_proxy api:8080 {
			# passa o IP real do cliente ({remote_host} é o peer da conexão,
			# não forjável) para a API logar e limitar por IP corretamente —
			# sem isto ela veria sempre o IP do container do Caddy. header_up
			# substitui qualquer X-Real-IP que o cliente tente enviar.
			header_up X-Real-IP {remote_host}
		}
	}

	# Todo o resto é o frontend.
	handle {
		reverse_proxy web:3000
	}
}

# Outros sites hospedados no mesmo VPS trazem o próprio bloco, num arquivo
# .caddy que cada projeto instala em /home/deploy/caddy/sites do host. É o que
# permite a esta configuração não saber que eles existem: o agendaGo não precisa
# ser editado (nem reimplantado) quando um vizinho entra ou sai.
#
# Os containers deles são alcançados pela rede Docker `borda`, declarada como
# externa no compose e criada pelo job `implantar` do CI.
import /etc/caddy/sites/*.caddy
