# Imagem de produção do frontend: compila com o adapter-node e roda o servidor
# Node autônomo gerado em build/. Em dev o compose continua usando npm run dev.
FROM node:26-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# PUBLIC_API_URL é resolvida em tempo de BUILD (import.meta.env do Vite), então
# o padrão precisa servir para qualquer domínio — senão a imagem publicada
# ficaria amarrada a um host só. `/api` é relativo: como o Caddy serve frontend
# e API na mesma origem, o navegador resolve para o domínio corrente. Funciona
# porque toda página que chama a API declara `ssr = false`, ou seja, o fetch
# nunca roda no servidor Node (onde um caminho relativo não teria base).
ARG PUBLIC_API_URL=/api
ENV PUBLIC_API_URL=${PUBLIC_API_URL}

RUN npm run build

FROM node:26-alpine

WORKDIR /app
ENV NODE_ENV=production

# O servidor do adapter-node roda com `node build` — npm, npx, yarn e corepack
# não são usados em runtime, mas vêm na imagem base e carregam as próprias
# dependências (é de dentro do npm que sai o `tar` que o Trivy acusa). Remover
# tira a vulnerabilidade, encolhe a imagem e deixa o container sem gerenciador
# de pacotes, que é o que se quer num ambiente de produção.
RUN rm -rf /usr/local/lib/node_modules/npm \
    /usr/local/lib/node_modules/corepack \
    /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
    /opt/yarn-* /usr/local/bin/yarn /usr/local/bin/yarnpkg

COPY --from=build /app/build ./build

USER node
EXPOSE 3000

CMD ["node", "build"]
