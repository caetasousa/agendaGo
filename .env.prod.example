# Variáveis de PRODUÇÃO — copie para .env no host e preencha.
# Consumido por docker-compose.prod.yml.
#
#   nano .env
#   docker compose -f docker-compose.prod.yml pull
#   docker compose -f docker-compose.prod.yml up -d

# ── Imagens ────────────────────────────────────────────────────────────────
# Onde estão as imagens publicadas pelo CI e qual versão usar. Os padrões do
# compose já apontam para ghcr.io/caetasousa e a tag `latest`; descomente para
# fixar uma versão específica (o CI também publica cada imagem com o SHA do
# commit, útil para rollback: IMAGE_TAG=<sha>).
#IMAGE_REPO=ghcr.io/caetasousa
#IMAGE_TAG=latest

# ── Domínio público ────────────────────────────────────────────────────────
# O hostname que aponta para o IP do host (ex.: um subdomínio grátis do
# DuckDNS). O Caddy pega o certificado HTTPS para ele automaticamente. NÃO use
# http:// nem barra final — só o host.
DOMINIO=agendago.duckdns.org

# ── Banco de dados (Postgres interno ao compose) ───────────────────────────
POSTGRES_DB=agendago
POSTGRES_USER=agendago
# Gere uma senha forte, ex.: openssl rand -base64 24
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# ── Pool de conexões da API ────────────────────────────────────────────────
# Comentadas = valem os padrões do projeto (10/2/60min/30min/60s). O padrão do
# pgx seria max(4, núcleos de CPU) — numa VPS de 1 vCPU, quatro conexões, o que
# faria o teto de concorrência da API depender do tamanho da máquina em vez de
# ser uma escolha. Ao subir DB_MAX_CONNS, confira o max_connections do Postgres
# (100 por padrão): ele é dividido com o job de migration e com qualquer psql.
# DB_MAX_CONNS=10
# DB_MIN_CONNS=2
# DB_MAX_CONN_LIFETIME_MIN=60
# DB_MAX_CONN_IDLE_MIN=30
# DB_HEALTHCHECK_SEC=60

# ── Admin semeado no boot (moderação) ──────────────────────────────────────
ADMIN_EMAIL=admin@seudominio.com
# Segredo forte — é a chave do painel de moderação. openssl rand -base64 24
ADMIN_SENHA=troque-por-uma-senha-forte

# ── Rate limiting ──────────────────────────────────────────────────────────
# MANTENHA todos > 0 em produção. Cada um cobre um ângulo diferente e nenhum
# substitui os outros:
#
#   por IP        quem ainda não se identificou (brute-force simples, rajadas
#                 que estouram a CPU do hashing de senha, raspagem da vitrine)
#   por conta     brute-force que troca de IP a cada tentativa — o teto por IP
#                 não vê nada, o por conta trava depois de N falhas em 5 min
#   por sessão    abuso depois do login, quando o IP não identifica mais nada
RATE_LIMIT_LOGIN_POR_MINUTO=10
RATE_LIMIT_CONVIDADO_POR_MINUTO=10
RATE_LIMIT_PUBLICO_POR_MINUTO=60
RATE_LIMIT_LOGIN_POR_CONTA=5
RATE_LIMIT_AUTENTICADO_POR_MINUTO=60

# ── Envio de email (ex.: Brevo) ────────────────────────────────────────────
# SMTP_HOST vazio desliga o envio (os emails só aparecem no log da API).
# Sem email funcionando, confirmação de cadastro, recuperação de senha e
# cancelamento de agendamento param de pé — trate como obrigatório.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# Usuário e chave SMTP ficam em Brevo → SMTP & API → SMTP (não é a senha da
# sua conta Brevo).
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# IMPORTANTE: o remetente NÃO pode ser @gmail/@outlook/@yahoo — o DMARC deles
# faz o email cair em spam ou ser rejeitado, porque quem envia é o Brevo, não
# o Google. Use um endereço do seu próprio domínio, autenticado na Brevo
# (SPF + DKIM). Um subdomínio DuckDNS não serve para isso: você não controla
# o DNS de duckdns.org.
EMAIL_REMETENTE=nao-responda@seudominio.com
EMAIL_REMETENTE_NOME=agendaGo
# Onde caem as respostas dos usuários (opcional): seu email pessoal.
EMAIL_REPLY_TO=

# ── Login social com Google ────────────────────────────────────────────────
# Vazio desliga o recurso (rotas e botão somem). Credenciais no Google Cloud
# Console (tipo "Web application").
#
# O callback é uma rota da API, e atrás do Caddy a API vive sob /api — a URL
# pública PRECISA do prefixo. Sem ele o Google devolve o usuário no frontend,
# que não tem essa rota, e o login social morre em 404 depois do consentimento.
#
# Esta URL exata (com https e sem barra final) tem de estar em "Authorized
# redirect URIs" no Google Cloud Console. O mesmo cliente OAuth aceita várias,
# então dá para ter dev, ensaio local e produção lado a lado:
#   http://localhost:8080/auth/google/callback          (dev, API direta)
#   https://localhost/api/auth/google/callback          (ensaio da VPS)
#   https://SEU_DOMINIO/api/auth/google/callback        (produção)
#
# O escopo pedido (login) sai do modo Testing sem verificação do app; se
# passar de 100 usuários de teste, o Google exige um processo de verificação.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://seudominio.com/api/auth/google/callback

# ── Rastreamento de erro ───────────────────────────────────────────────────
# Coletor compatível com o protocolo do Sentry (o Sentry em si ou uma instância
# GlitchTip). Vazio desliga o recurso; DSN inválido ABORTA o boot, porque pedir
# o recurso e não recebê-lo silenciosamente é pior do que não pedir.
#
# Corpo, cabeçalhos e query da requisição nunca são enviados (ver
# config/observabilidade.go): o contexto que sobe é rota, método e request_id.
SENTRY_DSN=
