# Imagem de migrations: o Flyway com os .sql já embutidos. Existe para que o
# host de produção não precise do repositório — sem ela, o job de migration
# dependeria de um bind mount de ./backend/migrations, obrigando a ter o
# código-fonte na VPS só para aplicar o schema.
#
# A linha 10 ficou presa no Alpine 3.20, que saiu de suporte: as correções de
# gnutls e openssl existem, mas não são publicadas para uma versão EOL, então
# a imagem carregava 5 CVEs CRITICAL sem conserto possível no lugar. A linha 13
# está no Alpine 3.23 e é reconstruída com frequência — zero CRITICAL.
FROM flyway/flyway:13-alpine

# Duas limpezas, pelo mesmo motivo: o que não roda aqui não deveria vir junto.
#
# 1) apk upgrade — a imagem oficial do Flyway é reconstruída em ritmo próprio, e
#    entre uma reconstrução e outra acumula correção já publicada pelo Alpine.
#
# 2) Remoção dos drivers e libs que este projeto nunca toca. O Flyway oficial
#    embarca 290 MB de drivers para vinte e tantos bancos; o agendaGo fala com
#    PostgreSQL e nada mais. Couchbase, Databricks e SQL Server carregavam netty,
#    jackson, lz4 e mssql-jdbc — e eram a origem de TODOS os alertas de
#    vulnerabilidade da aba Security do repositório. É a mesma jogada já aplicada
#    ao npm em frontend/Dockerfile.prod: a correção é remover, não atualizar,
#    porque não existe versão corrigida de uma dependência que não deveria estar
#    aqui. Resultado medido: 15 HIGH + 24 MEDIUM → 0 + 0.
#
# CUIDADO ao mexer nesta lista: o Flyway resolve os plugins de banco por
# ServiceLoader e os carrega avidamente. Remover /flyway/drivers/cassandra, por
# exemplo, derruba o boot com ClassNotFoundException de com.datastax.oss.driver,
# mesmo sem nenhum uso de Cassandra. Removeu algo? Rode as migrations contra um
# Postgres de verdade antes de confiar — o teste que vale é `flyway migrate`
# aplicando as 13 migrations e criando as 15 tabelas.
RUN apk upgrade --no-cache && \
    rm -rf /flyway/drivers/couchbase \
           /flyway/drivers/databricks-jdbc-*.jar \
           /flyway/drivers/mssql-jdbc-*.jar \
           /flyway/lib/netty

COPY migrations /flyway/sql
