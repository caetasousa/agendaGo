# Imagem de produção da API: build multi-stage que gera um binário estático,
# sem hot reload nem toolchain na imagem final. O Dockerfile (sem sufixo)
# continua sendo o de desenvolvimento (air + swag em watch).
#
# Note que aqui NÃO há swag: a doc interativa fica atrás da build tag `swagger`
# e não entra nesta imagem. Antes ela entrava — eram 10 MB de assets da UI e da
# spec, 37% do binário, para servir uma rota que produção nunca expôs.
FROM golang:1.26-alpine AS build

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Compila estático (sem CGO) para a imagem mínima. timetzdata embute o banco de
# fusos no binário — a imagem final não tem tzdata e o app carrega
# America/Sao_Paulo no boot. Sem a tag `swagger`, de propósito.
RUN CGO_ENABLED=0 go build -tags timetzdata -ldflags="-s -w" -o /bin/api ./cmd/api

# Base mantida numa versão de Alpine ainda em suporte: as correções de openssl e
# busybox não são publicadas para versão EOL, então uma base velha acumula CVE sem
# conserto possível no lugar — foi exatamente o que aconteceu com a imagem de
# migrations (ver Dockerfile.migrations). Como o portão do CI só trava em CRITICAL,
# nada força esta linha a subir: conferir a aba Security a cada release do Alpine.
FROM alpine:3.24

# certificados TLS (chamadas HTTPS de saída) e usuário sem privilégios
RUN apk add --no-cache ca-certificates && \
    adduser -D -u 10001 agendago
USER agendago

COPY --from=build /bin/api /usr/local/bin/api

EXPOSE 8080

# /ready, não /health: o liveness responde "ok" mesmo com o banco fora do ar, e um
# healthcheck que nunca reprova não informa nada. O 503 de /ready faz o container
# aparecer como unhealthy enquanto a API não consegue atender de fato.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
    CMD wget -qO- http://localhost:8080/ready || exit 1

ENTRYPOINT ["api"]
